# Local API proxies (Vite dev server)
VITE_GRAPHQL_PROXY_URL=http://localhost:8080
VITE_AUTH_PROXY_URL=http://localhost:8081

# Production build values (Docker)
VITE_GRAPHQL_URL=/graphql
VITE_AUTH_SERVER_URL=/auth
VITE_GOOGLE_AUTH_URL=/auth/google
VITE_CALLBACK_URL=http://localhost:3000/vm/auth/callback

# Public business website hosting
VITE_PUBLIC_SITE_BASE_DOMAIN=venturemate.net
VITE_PUBLIC_SITE_CNAME_TARGET=sites.venturemate.net
