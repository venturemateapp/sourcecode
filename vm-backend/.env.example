PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=venturematedb
DB_PASSWORD=CHANGE_ME
DB_NAME=venturematedb
DB_SSLMODE=disable

# VentureMate AI: OpenRouter is the default for every user and subscription plan.
AI_PROVIDER=openrouter
AI_ALLOW_PROVIDER_OVERRIDE=true
AI_FALLBACK_PROVIDERS=openrouter,gemini,openai,claude,grok
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional providers. Leave keys empty until each service is connected.
GEMINI_API_KEY=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
CLAUDE_API_KEY=
CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages
CLAUDE_MODEL=claude-sonnet-4-6
GROK_API_KEY=
GROK_ENDPOINT=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-4.3

# Email Service
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM_NAME=VentureMate
EMAIL_LOGO_URL=

# S3-compatible object storage
S3_BUCKET=CHANGE_ME
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Public website hosting
PUBLIC_SITE_BASE_DOMAIN=venturemate.net
PUBLIC_SITE_CNAME_TARGET=sites.venturemate.net
